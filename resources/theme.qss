/* UxPlay Studio design system — native Qt, tuned for a creator workspace. */
* {
    font-family: "Segoe UI Variable", "Segoe UI";
    font-size: 13px;
    color: #F1F1F3;
}

QMainWindow,
QWidget#appRoot,
QWidget#content,
QWidget#page,
QScrollArea#settingsScroll,
QScrollArea#settingsScroll > QWidget > QWidget {
    background: #151619;
}

QWidget#sidebar {
    background: #1B1C20;
    border-right: 1px solid #2E3036;
}
QLabel#brandMark {
    color: #FFFFFF;
    background: #5B8CFF;
    border-radius: 10px;
    font-size: 17px;
    font-weight: 800;
    qproperty-alignment: AlignCenter;
}
QLabel#brand {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 1px;
    qproperty-alignment: AlignCenter;
}
QLabel#sidebarReceiver {
    color: #858A96;
    font-size: 10px;
    qproperty-alignment: AlignCenter;
}
QLabel#sidebarFooter { color: #646873; font-size: 9px; qproperty-alignment: AlignCenter; }
QPushButton#navButton {
    min-height: 54px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    color: #989CA7;
    font-size: 11px;
    font-weight: 550;
    padding: 4px 8px;
    text-align: left;
}
QPushButton#navButton:hover {
    background: #23252A;
    color: #FFFFFF;
}
QPushButton#navButton:checked {
    background: #292B31;
    border-color: #383B43;
    color: #FFFFFF;
}

QWidget#header {
    background: #18191D;
    border-bottom: 1px solid #2D2F35;
}
QLabel#pageEyebrow {
    color: #858A96;
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 1px;
}
QLabel#pageTitle { color: #FFFFFF; font-size: 18px; font-weight: 650; }
QLabel#localBadge,
QLabel#statusBadge {
    background: #202227;
    border: 1px solid #363941;
    border-radius: 15px;
    color: #B7BBC6;
    font-size: 11px;
    font-weight: 600;
    padding: 6px 11px;
}
QLabel#statusBadge[tone="ready"] { color: #69D7A2; border-color: #315744; }
QLabel#statusBadge[tone="live"] { color: #FF7186; border-color: #66323B; }
QLabel#statusBadge[tone="warning"] { color: #F1C86B; border-color: #66552D; }
QLabel#statusBadge[tone="idle"] { color: #A2A6B0; }

QPushButton {
    min-height: 38px;
    border-radius: 8px;
    padding: 0 13px;
}
QPushButton:focus, QLineEdit:focus, QComboBox:focus, QListWidget:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #6D9AFF;
}
QPushButton#primaryButton,
QPushButton#receiverButton {
    background: #5B8CFF;
    border: 1px solid #6D9AFF;
    color: #0E1420;
    font-weight: 700;
}
QPushButton#primaryButton:hover,
QPushButton#receiverButton:hover { background: #71A0FF; }
QPushButton#receiverButton[running="true"] {
    background: #22242A;
    border-color: #3B3E46;
    color: #F1F1F3;
}
QPushButton#secondaryButton,
QPushButton#fullscreenButton {
    background: #22242A;
    border: 1px solid #383B43;
    color: #E6E7EA;
    font-weight: 600;
}
QPushButton#secondaryButton:hover,
QPushButton#fullscreenButton:hover { background: #2B2E34; border-color: #4A4E58; }
QPushButton#ghostButton {
    background: transparent;
    border: 1px solid transparent;
    color: #A9ADB7;
}
QPushButton#ghostButton:hover { background: #26282E; color: #FFFFFF; }
QPushButton:disabled { color: #666A74; background: #202126; border-color: #2B2D32; }

QWidget#playerCard {
    background: #101114;
    border: 0;
}
QWidget#studioToolbar,
QWidget#playerChrome {
    background: #18191D;
    border-bottom: 1px solid #2C2E34;
}
QWidget#stageFrame {
    background: #101114;
}
QLabel#stageHint { color: #777C87; font-size: 11px; }
QLabel#miniBadge {
    color: #A8C1FF;
    background: #202A42;
    border: 1px solid #303F61;
    border-radius: 9px;
    padding: 4px 8px;
    font-size: 9px;
    font-weight: 700;
}
QPushButton#segmentedButton {
    min-height: 34px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    color: #90949F;
    padding: 0 11px;
    font-weight: 600;
}
QPushButton#segmentedButton:hover { background: #23252A; color: #FFFFFF; }
QPushButton#segmentedButton:checked {
    background: #30333A;
    border-color: #424650;
    color: #FFFFFF;
}

QStackedWidget#previewStack,
QWidget#videoSurface,
QWidget#nativeVideoTarget,
QGraphicsView#sceneCanvas {
    background: #08090B;
    border: 0;
}
QWidget#videoPlaceholder {
    background: #0D0F12;
    border: 1px solid #25282E;
    border-radius: 12px;
}
QLabel#airplayMark {
    color: #83A9FF;
    font-size: 46px;
    font-weight: 300;
}
QLabel#videoPlaceholderTitle { color: #FFFFFF; font-size: 28px; font-weight: 650; }
QLabel#videoPlaceholderDetail { color: #9398A4; font-size: 13px; }
QWidget#connectStep {
    background: #15171B;
    border: 1px solid #292C33;
    border-radius: 9px;
}
QLabel#stepNumber {
    color: #9EB9FF;
    background: #232B3D;
    border-radius: 10px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    font-size: 10px;
    font-weight: 700;
    qproperty-alignment: AlignCenter;
}
QLabel#stepTitle { color: #F0F1F3; font-size: 11px; font-weight: 650; }
QLabel#stepCopy { color: #808590; font-size: 10px; }

QWidget#recordDock,
QWidget#playerControls {
    background: #1D1F24;
    border-top: 1px solid #303239;
    border: 1px solid #353840;
}
QPushButton#dockButton,
QCheckBox#dockToggle {
    min-height: 40px;
    background: transparent;
    border: 0;
    border-radius: 8px;
    color: #A9ADB7;
    font-size: 11px;
    font-weight: 600;
    padding: 0 9px;
}
QPushButton#dockButton:hover,
QCheckBox#dockToggle:hover { background: #292C32; color: #FFFFFF; }
QCheckBox#dockToggle::indicator { width: 0; height: 0; }
QCheckBox#dockToggle:checked { background: #2B2E35; color: #FFFFFF; }
QLabel#recordTime {
    color: #EDEEF1;
    font-family: "Cascadia Mono", "Consolas";
    font-size: 12px;
    font-weight: 700;
    min-width: 58px;
    qproperty-alignment: AlignCenter;
}
QPushButton#recordButton {
    min-width: 126px;
    min-height: 42px;
    background: #5B8CFF;
    border: 1px solid #6D9AFF;
    border-radius: 9px;
    color: #0E1420;
    font-weight: 750;
}
QPushButton#recordButton:hover { background: #71A0FF; }
QPushButton#recordButton[recording="true"] {
    background: #D94F65;
    border-color: #F16A7E;
    color: #FFFFFF;
}

QWidget#studioDock {
    background: #1A1B1F;
    border-left: 1px solid #303239;
}
QSplitter#playerSplitter {
    background: #101114;
}
QSplitter#playerSplitter::handle {
    background: #2B2E35;
    border-left: 1px solid #3A3D45;
    border-right: 1px solid #17181B;
}
QSplitter#playerSplitter::handle:hover {
    background: #5B8CFF;
}
QSplitter#sourceAreaSplitter::handle,
QSplitter#layerAreaSplitter::handle {
    background: #2B2E35;
    border-top: 1px solid #3A3D45;
    border-bottom: 1px solid #17181B;
}
QSplitter#sourceAreaSplitter::handle:hover,
QSplitter#layerAreaSplitter::handle:hover {
    background: #5B8CFF;
}
QWidget#canvasViewControls { background: transparent; }
QScrollArea#layerInspectorScroll,
QWidget#layerInspectorContent { background: transparent; border: 0; }
QPushButton#zoomOutButton,
QPushButton#zoomInButton,
QPushButton#fitCanvasButton {
    min-height: 30px;
    max-height: 30px;
    background: #22242A;
    border: 1px solid #353840;
    border-radius: 7px;
    color: #D9DCE3;
    font-size: 11px;
    font-weight: 650;
    padding: 0 7px;
}
QPushButton#zoomOutButton,
QPushButton#zoomInButton { min-width: 30px; max-width: 30px; padding: 0; font-size: 15px; }
QPushButton#zoomOutButton:hover,
QPushButton#zoomInButton:hover,
QPushButton#fitCanvasButton:hover {
    background: #2C2F36;
    border-color: #5B8CFF;
    color: #FFFFFF;
}
QLabel#zoomLabel {
    color: #E4E7EE;
    font-family: "Cascadia Mono", "Consolas";
    font-size: 10px;
    font-weight: 700;
}
QLabel#dockHeading { color: #FFFFFF; font-size: 15px; font-weight: 650; }
QLabel#dockTitle {
    color: #858A96;
    font-size: 9px;
    font-weight: 750;
    letter-spacing: 1px;
    padding-top: 4px;
}
QLabel#sessionMini { color: #E8E9EC; font-weight: 650; }
QLabel#recordingStatus { color: #A9ADB7; font-size: 11px; }
QWidget#streamCard,
QWidget#confidenceCard {
    background: #202126;
    border: 1px solid #30333A;
    border-radius: 10px;
}
QLabel#detailKey { color: #858A96; font-size: 10px; }
QLabel#detailValue { color: #E4E5E8; font-size: 10px; font-weight: 600; }

QListWidget#sourceList,
QListWidget#layerList {
    background: #15161A;
    border: 1px solid #303239;
    border-radius: 9px;
    color: #DDDFE4;
    outline: 0;
    padding: 4px;
}
QListWidget#sourceList::item,
QListWidget#layerList::item {
    min-height: 36px;
    border-radius: 6px;
    padding: 6px 8px;
}
QListWidget#sourceList::item:hover,
QListWidget#layerList::item:hover { background: #24262C; }
QListWidget#sourceList::item:selected,
QListWidget#layerList::item:selected { background: #2B3447; color: #FFFFFF; }
QPushButton#sourceButton {
    min-height: 40px;
    background: #22242A;
    border: 1px solid #353840;
    border-radius: 8px;
    color: #C8CBD2;
    font-size: 10px;
    padding: 0 8px;
}
QPushButton#sourceButton:hover { background: #2C2F36; color: #FFFFFF; border-color: #484C56; }
QPushButton#iconButton {
    min-width: 38px;
    max-width: 38px;
    min-height: 36px;
    padding: 0;
    background: #22242A;
    border: 1px solid #353840;
    border-radius: 8px;
}
QPushButton#iconButton:hover { background: #2D3037; border-color: #4A4E58; }

QLineEdit, QComboBox, QDoubleSpinBox {
    background: #15161A;
    border: 1px solid #353840;
    border-radius: 8px;
    color: #F0F1F3;
    min-height: 38px;
    padding: 0 10px;
    selection-background-color: #5B8CFF;
}
QComboBox#compactCombo { min-height: 36px; font-size: 11px; padding: 0 8px; }
QDoubleSpinBox#transformSpin {
    min-width: 68px;
    min-height: 30px;
    max-height: 30px;
    padding: 0 16px 0 5px;
    font-size: 10px;
}
QDoubleSpinBox#transformSpin::up-button,
QDoubleSpinBox#transformSpin::down-button { width: 14px; border: 0; }
QWidget#transformPanel { background: transparent; }
QComboBox::drop-down { border: 0; width: 24px; }
QComboBox QAbstractItemView { background: #202126; border: 1px solid #3A3D45; selection-background-color: #34415B; }

QWidget#card {
    background: #1D1F23;
    border: 1px solid #303239;
    border-radius: 12px;
}
QWidget#projectSurface { background: transparent; }
QLabel#cardTitle { color: #FFFFFF; font-size: 16px; font-weight: 650; }
QLabel#sectionTitle { color: #FFFFFF; font-size: 30px; font-weight: 650; }
QLabel#mutedLabel { color: #9297A2; }

QListWidget#projectList {
    background: transparent;
    border: 0;
    outline: 0;
    padding: 0;
}
QListWidget#projectList::item {
    background: #1D1F23;
    border: 1px solid #303239;
    border-radius: 11px;
    color: #E8E9EC;
    padding: 10px;
}
QListWidget#projectList::item:hover { background: #23252A; border-color: #454952; }
QListWidget#projectList::item:selected { background: #293247; border-color: #5B79B8; color: #FFFFFF; }
QWidget#recoveryBanner {
    background: #2B281E;
    border: 1px solid #5B5130;
    border-radius: 11px;
}

QCheckBox { spacing: 9px; min-height: 32px; color: #D6D8DD; }
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #50545F;
    border-radius: 5px;
    background: #15161A;
}
QCheckBox::indicator:checked { background: #5B8CFF; border-color: #77A2FF; }
QLineEdit:disabled { color: #666A74; background: #1A1B1F; }

QTextEdit#activityLog,
QPlainTextEdit#diagnosticsText {
    background: #111216;
    border: 1px solid #303239;
    border-radius: 9px;
    color: #C9CCD3;
    font-family: "Cascadia Mono", "Consolas";
    font-size: 12px;
    padding: 12px;
}
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #3D4048; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; }
QScrollBar::handle:horizontal { background: #3D4048; border-radius: 5px; min-width: 30px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QToolTip { background: #292B31; border: 1px solid #444750; color: #FFFFFF; padding: 6px; }

QWidget#page[fullscreen="true"],
QWidget#playerCard[fullscreen="true"],
QWidget#videoSurface[fullscreen="true"],
QWidget#videoSurface[fullscreen="true"] QWidget#nativeVideoTarget,
QWidget#videoSurface[fullscreen="true"] QWidget#videoPlaceholder {
    background: #000000;
    border: 0;
    border-radius: 0;
}
